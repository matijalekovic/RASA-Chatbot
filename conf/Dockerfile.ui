FROM nginx:alpine

# Copy nginx config
COPY ui/nginx.conf /etc/nginx/conf.d/default.conf

# Copy HTML template and startup script
COPY ui/index.html.template /usr/share/nginx/html/index.html.template
COPY ui/start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 80

# envsubst replaces ${RASA_API_URL} at startup, then nginx serves the result
CMD ["/start.sh"]
